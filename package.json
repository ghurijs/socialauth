{
  "name": "@ghuri/socialauth",
  "version": "0.1.0-alpha.0",
  "description": "Ghuri social login in django-allauth style: GitHub, Google, Facebook, Microsoft, Discord, GitLab and any OpenID Connect provider",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/socialauth#readme",
  "repository": { "type": "git", "url": "git+https://github.com/ghurijs/socialauth.git" },
  "bugs": { "url": "https://github.com/ghurijs/socialauth/issues" },
  "keywords": ["ghuri", "django", "allauth", "social-login", "oauth", "openid-connect", "github", "google", "cloudflare", "workers"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./admin": { "types": "./dist/admin.d.ts", "import": "./dist/admin.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "peerDependencies": {
    "@ghuri/admin": "^0.1.0-alpha.0",
    "@ghuri/auth": "^0.1.0-alpha.2",
    "@ghuri/core": "^0.1.0-alpha.1",
    "@ghuri/oauth": "^0.1.0-alpha.0",
    "@ghuri/orm": "^0.1.0-alpha.1",
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": { "@ghuri/admin": { "optional": true } },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@ghuri/admin": "^0.1.0-alpha.0",
    "@ghuri/auth": "^0.1.0-alpha.2",
    "@ghuri/core": "^0.1.0-alpha.1",
    "@ghuri/oauth": "^0.1.0-alpha.0",
    "@ghuri/orm": "^0.1.0-alpha.1",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^13.1.1",
    "esbuild": "^0.27.7",
    "hono": "^4.13.0",
    "miniflare": "^4.20260730.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": { "access": "public", "tag": "next" }
}
